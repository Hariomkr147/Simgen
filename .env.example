# ============================================================ OpenRouter gateway
# One base URL, one key, every model. Get a key at https://openrouter.ai/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-...

# ---------------------------------------------------------------- role bindings
TEACHER=opus5
STUDENT=gemini38flash        # or 'auto': pick the student by difficulty (below)
# jev113 (TypeSafe's decision model) is ~500x cheaper than a chat-model judge, but measured
# scores cluster tight (opus5.5 and cheap students both land ~80-90%) -- it doesn't discriminate
# real quality gaps. A cheap CHAT model that actually reads the code judges better for not much
# more money (~$0.003/file vs jev's ~$0.0003/file). jev113 stays wired in (JUDGE=jev113) if needed.
JUDGE=deepseekv41flash
# Opus 5 judging every generation got expensive fast -- off by default. Set to true
# to auto-judge every new generation again (python judge_library.py backfills old ones).
JUDGE_ENABLED=true

# Which aliases appear in the live UI's dropdowns (comma list). Frontier models plan,
# cheap models build — keep the expensive ones out of the student list.
TEACHER_MODELS=sonnet55,opus55,opus5,fable51,astra6,glm53,sol6
STUDENT_MODELS=sonnet55,musespark13c,gemini38flash,deepseekv41flash,opus55,glm53,sol6,gemini37flash,hy4preview

# ---------------------------------------------------------------- models
# Per alias: MODEL_<alias>_{ID,IN,OUT}. BASE_URL/API_KEY fall back to LLM_* above,
# so a model only needs its own block if it lives somewhere other than OpenRouter.
# IN / OUT are USD per 1,000,000 tokens — a fallback only: OpenRouter reports the
# real charged cost per call and the pipeline prefers that (report.json says which,
# via cost_source: "reported" | "table").
# Slugs and prices below were read from https://openrouter.ai/api/v1/models —
# re-check with:  curl -s https://openrouter.ai/api/v1/models | grep -o '"id":"[^"]*"'

MODEL_astra6_ID=openai/gpt-6-astra
MODEL_astra6_IN=10
MODEL_astra6_OUT=50

MODEL_fable51_ID=anthropic/claude-fable-5.1
MODEL_fable51_IN=10
MODEL_fable51_OUT=50

MODEL_opus5_ID=anthropic/claude-opus-5
MODEL_opus5_IN=5
MODEL_opus5_OUT=25

MODEL_opus55_ID=anthropic/claude-opus-5.5
MODEL_opus55_IN=4
MODEL_opus55_OUT=20

MODEL_sonnet55_ID=anthropic/claude-sonnet-5.5
MODEL_sonnet55_IN=2
MODEL_sonnet55_OUT=10

MODEL_glm53_ID=z-ai/glm-5.3
MODEL_glm53_IN=0.84
MODEL_glm53_OUT=2.64

MODEL_sol6_ID=openai/gpt-6-sol
MODEL_sol6_IN=2.0
MODEL_sol6_OUT=10.0

# ---- cheap students
MODEL_gemini38flash_ID=google/gemini-3.8-flash
MODEL_gemini38flash_IN=0.75
MODEL_gemini38flash_OUT=3.75



MODEL_glm53flash_ID=z-ai/glm-5.3-flash
MODEL_glm53flash_IN=0.15
MODEL_glm53flash_OUT=0.50



# Batch variants: same models at ~50% off, higher latency. Use these for the
# offline blueprint backfill (phase 4 in PLAN.md), never for live queries.
MODEL_astra6batch_ID=openai/gpt-6-astra:batch
MODEL_astra6batch_IN=5
MODEL_astra6batch_OUT=25

MODEL_opus5batch_ID=anthropic/claude-opus-5:batch
MODEL_opus5batch_IN=2.50
MODEL_opus5batch_OUT=12.50

# ============================================================ NCERT grounding
# Postgres full-text search — no embedding model, no vector column needed.
# Leave NCERT_DSN empty to run without retrieval.
NCERT_DSN=postgresql://user:pass@host:5432/ncert
NCERT_TOP_K=6
# Real schema (gyansetu): text lives in knowledge_graph.graph_nodes.ground_truth_content,
# keyed by class_level. The matching default query already lives in simgen/retrieve.py
# (DEFAULT_SQL) — leave NCERT_SQL unset unless you need to override it.
# Named params available if you do: %(q)s (raw topic text) %(grade)s %(k)s

# UI shows costs in INR at this rate (OpenRouter bills USD). Rate as of 2026-09-23.
USD_INR=95.6

# ============================================================ access gate
# Require this code to be entered before /run will actually trigger a
# (paid) generation -- protects your API budget on a public deploy.
# Leave empty to disable the gate (e.g. local/private use).
ACCESS_CODE=

# GPT 6 Luna Pro (OpenRouter) - cheap student
MODEL_luna6pro_ID=openai/gpt-6-luna-pro
MODEL_luna6pro_IN=0.10
MODEL_luna6pro_OUT=0.50

# Muse Spark 1.3 Contributor (Meta may use prompts/outputs for training) - student
MODEL_musespark13c_ID=meta/muse-spark-1.3-contributor
MODEL_musespark13c_IN=0.10
MODEL_musespark13c_OUT=0.20

# Grok 4.7 - student
MODEL_grok47_ID=x-ai/grok-4.7
MODEL_grok47_IN=1.60
MODEL_grok47_OUT=4.80

# MiMo V2.6 Pro Ultraspeed - student (fast, ~10x the standard Pro price)
MODEL_mimo26pro_ID=xiaomi/mimo-v2.6-pro-ultraspeed
MODEL_mimo26pro_IN=4.35
MODEL_mimo26pro_OUT=8.70

# DeepSeek V4.1 Flash - student
MODEL_deepseekv41flash_ID=deepseek/deepseek-v4.1-flash
MODEL_deepseekv41flash_IN=0.14
MODEL_deepseekv41flash_OUT=0.42

# Qwen 3.8 Max (0902) - hard-tier student
MODEL_qwen38max_ID=qwen/qwen3.8-max-0902
MODEL_qwen38max_IN=2.0
MODEL_qwen38max_OUT=6.0

# TypeSafe Jev 1.13 -- a "decision model", not a chat model. Only used for JUDGE=jev113
# (simgen/pipeline.py calls OpenRouter's separate Decisions API directly for it, not
# the chat/completions path every other model here goes through). $0.042/M in, output free.
MODEL_jev113_ID=typesafe/jev-1.13

# Gemini 3.7 Flash - student (Arena WebDev: edges out 3.8 Flash on code quality, same price)
MODEL_gemini37flash_ID=google/gemini-3.7-flash
MODEL_gemini37flash_IN=0.75
MODEL_gemini37flash_OUT=3.75

# Tencent Hy4 Preview - student (MoE, 49B active/770B total, built for coding)
MODEL_hy4preview_ID=tencent/hy4-preview
MODEL_hy4preview_IN=0.834
MODEL_hy4preview_OUT=2.501

# ============================================================ difficulty routing (student = auto)
# estimate_tier() guesses easy/medium/hard from topic + class before any model is paid; the teacher's
# blueprint (build_tier, number of equations) can only raise it; a broken build moves up a tier.
STUDENT_EASY=musespark13c
STUDENT_MEDIUM=gemini38flash
STUDENT_HARD=opus55
# 1 = a topic estimated hard skips the blueprint and STUDENT_HARD builds it whole in one call
# (no stored blueprint, no evidence check). Default off.
HARD_SINGLE=0
